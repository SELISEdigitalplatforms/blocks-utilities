<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only used by Dockerfile.worker's dss-build stage, to resolve EU DSS and its dependencies into
  one lib/ directory. DssValidator.java is compiled against that directory with plain javac, the
  same way tools/pdfbox/*.java is compiled against the pdfbox-app jar. Nothing here is packaged.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>blocks.utilities</groupId>
    <artifactId>dss-validator</artifactId>
    <version>0</version>
    <packaging>pom</packaging>

    <properties>
        <dss.version>6.5</dss.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>eu.europa.ec.joinup.sd-dss</groupId>
                <artifactId>dss-bom</artifactId>
                <version>${dss.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- PAdES validation, on PDFBox 3 (the version the image's pdfbox tools already use). -->
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-pades-pdfbox</artifactId>
        </dependency>
        <!-- The validation process and its simple / diagnostic reports; not transitive in 6.x. -->
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-validation</artifactId>
        </dependency>
        <!-- DSS's default validation policy (policy/constraint.xml); without it every signature and
             every trusted list fails with "Unable to load the policy". Also not transitive. -->
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-policy-jaxb</artifactId>
        </dependency>
        <!-- DSS 6 needs one CMS implementation chosen explicitly. The in-memory one suits files of a
             few MB; dss-cms-stream is the alternative for very large files. -->
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-cms-object</artifactId>
        </dependency>
        <!-- LOTL / trusted-list loading, with the file cache. -->
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-tsl-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-service</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-utils-apache-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-crl-parser-x509crl</artifactId>
        </dependency>
        <!-- stdin/stdout protocol. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.2</version>
        </dependency>
        <!-- DSS logs through SLF4J. slf4j-simple writes to stderr, keeping stdout for the protocol. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.18</version>
        </dependency>
    </dependencies>
</project>
