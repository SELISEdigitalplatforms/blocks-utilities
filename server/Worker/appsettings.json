{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MailCategory": {
    "LargeAttachmentThresholdInMb": 3
  },
  "MicrosoftGraphMail": {
    "NoAttachmentMaxConcurrentSends": 15,
    "SmallAttachmentMaxConcurrentSends": 8,
    "LargeAttachmentMaxConcurrentSends": 2,
    "MaxSubmissionRetryAttempts": 5,
    "InitialSubmissionRetryDelaySeconds": 30,
    "MaxSubmissionRetryDelaySeconds": 900,
    "SubmissionProcessingLockTimeoutMinutes": 30
  },
  "MicrosoftGraphProviderRateLimiting": {
    "Enabled": true,
    "PerTenantPerMinuteSubmissionLimit": 600,
    "PerClientPerMinuteSubmissionLimit": 300,
    "PerSenderPerMinuteSubmissionLimit": 120,
    "LargeAttachmentPerSenderPerMinuteSubmissionLimit": 30,
    "DefaultRetryAfterSeconds": 60
  },
  "MailOutbox": {
    "Enabled": true,
    "PollIntervalSeconds": 10,
    "BatchSize": 50,
    "MaxPublishAttempts": 10,
    "InitialRetryDelaySeconds": 10,
    "MaxRetryDelaySeconds": 300
  },
  "MailDeliveryTracking": {
    "InitialDelayInMinutes": 5,
    "MaxAttempts": 6,
    "RetryDelayMinutes": [ 15, 30, 60 ]
  }
}
