<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Version>9.0.0-preview.15</Version>
		<PackageId>SeliseBlocks.MfaDriver</PackageId>
		<Authors>SeliseBlocks</Authors>
		<Company>SeliseBlocks</Company>
		<Description>Blocks MFA Driver</Description>
		<IncludeBuildOutput>true</IncludeBuildOutput>
    	<IncludeOutputAssemblies>true</IncludeOutputAssemblies>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>Genesis, BlocksGenesis, SeliseBlocksGenesis, MFA , Driver</PackageTags>
		<RepositoryUrl>https://github.com/SELISEdigitalplatforms/blocks-idp-net</RepositoryUrl>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

  	<ItemGroup>
    	<ProjectReference Include="../Mfa.DomainService/Mfa.DomainService.csproj" PrivateAssets="All" />
  	</ItemGroup>
	
	<ItemGroup>
   		<None Include="$(OutputPath)Mfa.DomainService.dll" Pack="true" PackagePath="lib/net9.0/" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SeliseBlocks.MailDriver" Version="9.0.0-preview.15" />
    <PackageReference Include="Otp.NET" Version="1.4.0" />
	</ItemGroup>

	<PropertyGroup>
    	<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
</Project>
