{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MailRateLimiting": {
    "Enabled": true,
    "DefaultPerProjectPerMinuteRecipientLimit": 300,
    "DefaultPerProjectPerHourRecipientLimit": 3000,
    "DefaultPerTenantPerMinuteRecipientLimit": 1000,
    "DefaultPerTenantPerHourRecipientLimit": 10000,
    "DefaultPerSenderPerMinuteRecipientLimit": 500,
    "RedisFailureRetryAfterSeconds": 30
  },
  "ApiRateLimiting": {
    "Enabled": true,
    "MailSendPermitLimit": 60,
    "MailSendWindowSeconds": 60,
    "MailSendQueueLimit": 0,
    "GeneralPermitLimit": 300,
    "GeneralWindowSeconds": 60,
    "GeneralQueueLimit": 0
  },
  "AmazonSes": {
    "DeliveryTrackingEnabled": false,
    "ConfigurationSetName": "blocks-mail-delivery",
    "NotificationTopicArn": "",
    "AutomaticallyConfirmSubscription": true
  }
}
