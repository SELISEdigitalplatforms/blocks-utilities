{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "OpenApi": {
    "Enabled": true
  },
  "Payment": {
    "ProviderTimeoutSeconds": 15,
    "ProcessingLeaseSeconds": 30,
    "DistributedLockSeconds": 20,
    "DistributedLockWaitMilliseconds": 750,
    "ProviderCacheSeconds": 120,
    "TenantRequestsPerMinute": 300,
    "ActorRequestsPerMinute": 30,
    "OrderRequestsPerMinute": 10,
    "CheckoutCallbackStateLifetimeMinutes": 60,
    "MaximumReturnParameterLength": 8192,
    "WebhookIntakeTimeoutSeconds": 180,
    "MaximumWebhookBodyBytes": 262144,
    "ReturnRequestsPerClientPerMinute": 60,
    "ReturnRequestsPerStatePerMinute": 12,
    "EncryptionKeyRingCacheSeconds": 300,
    "EncryptionKeyRingFailureCacheSeconds": 30,
    "EncryptionKeyRingDisposalGraceSeconds": 60,
    "FallBackToSharedEncryptionKeyRing": true,
    "AutoProvisionKeyRing": true,
    "ConsoleOrganizationId": "default",
    "CurrencyMinorUnits": {
      "BDT": 2,
      "EUR": 2,
      "GBP": 2,
      "USD": 2,
      "JPY": 0
    },
    "PublicBaseUrl": "https://dev-utilities.blocksdevelopers.com:5000",
    "IamBaseUrl": ""
  }
}
