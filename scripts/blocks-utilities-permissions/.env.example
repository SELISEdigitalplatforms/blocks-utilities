# -----------------------------------------------------------------------------
# Connection and settings for the blocks-utilities permission seeder.
#
# Copy this file to ".env" in the same directory and fill in the values for the
# environment you are seeding. ".env" is gitignored - never commit a real
# credential.
#
#     cp .env.example .env
#
# run.ps1 / run.sh read ".env" automatically. A variable already exported in the
# shell wins over the file, so CI can supply the URI from a secret store without
# a file existing at all.
# -----------------------------------------------------------------------------

# REQUIRED. The cluster to seed. No database is named here: the script finds the
# tenant databases itself from BlocksRootDb.Tenants, so the account needs read
# on the root database and write on the tenant databases.
BLOCKS_MONGO_URI=mongodb://<user>:<password>@<host>:27017/?authSource=admin&socketTimeoutMS=0

# OPTIONAL. Comma-separated tenant databases to restrict the run to. Leave empty
# for every tenant. Use this to pilot one tenant before the full rollout.
SEED_ONLY_DBS=

# OPTIONAL. BaseEntity.OrganizationId on the inserted rows. "default" is the
# value ProtectedEndpointAccessHandler falls back to when a caller's context
# carries no organization, so it is what makes a permission apply tenant-wide.
SEED_ORGANIZATION_ID=default

# OPTIONAL. Blocks OS user id to record as CreatedBy / LastUpdatedBy, so the
# rows are attributable to whoever ran the seed. Empty leaves them null.
SEED_CREATED_BY=

# OPTIONAL. Label format. {db} is the tenant database, {tenant} its display
# name, {name} the permission label, {resource} the full resource string.
# Name is only a label - authorization matches on Resource.
SEED_NAME_TEMPLATE={db} - {name}

# OPTIONAL. Roles to attach at insert time. Empty is deliberate: seeding grants
# nobody anything, and roles are assigned in Blocks OS afterwards.
SEED_ROLES=

# OPTIONAL. Container image used when mongosh is not installed. Any mongo:6+
# image carries mongosh.
SEED_DOCKER_IMAGE=mongo:7
